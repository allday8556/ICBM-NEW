{
    "version": "1.3",
    "note": "Fixture host configuration (automation/agent-host/tests/fx-harness.ps1). The harness replaces repository and repo_path. It mirrors the operating defaults of AGENT_HOST_AUDIT_PROTOCOL 0.2: auto_merge and auto_next are on. The retry ceiling is small so that a fixture ends quickly.",
    "repository": "fixture/icbm",
    "repo_path": "",
    "auto_merge": true,
    "auto_merge_method": "merge",
    "auto_next": {
        "enabled": true
    },
    "technical_hold": {
        "max_same_state_retries": 2,
        "max_backoff_seconds": 2
    },
    "full_audit_policy": {
        "default_mode": "DELTA",
        "defer_full_until_pre_live": true,
        "full_interval_days": 7,
        "max_consecutive_delta": 10,
        "full_triggers": {
            "ARCHITECTURE_OR_ADR": [],
            "SCHEMA_OR_MIGRATION": [],
            "PROVIDER_OR_LIVE_BOUNDARY": [],
            "MILESTONE_OR_GATE_CLOSEOUT": []
        },
        "milestone_marker_file": "app/__init__.py",
        "milestone_marker_pattern": "MILESTONE\\s*=\\s*\"([^\"]+)\""
    },
    "repair_loop": {
        "enabled": true,
        "fixer": "claude-code",
        "auto_fix_on_gpt_blocker": true,
        "auto_fix_on_claude_blocker": true,
        "auto_remediate_full_audit_blocker": true,
        "max_cycles": 3
    }
}
