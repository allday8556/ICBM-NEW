{
  "manifest_version": 3,
  "name": "ICBM Capture",
  "description": "Captures one reviewed supplier product page and sends it to the local ICBM application.",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "action": {
    "default_title": "ICBM Capture"
  },
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["scripting", "sidePanel", "storage"],
  "host_permissions": ["https://kmretail.co.kr/*", "https://upickb2b.com/*", "https://www.ggsan.com/*", "http://127.0.0.1/*"]
}
