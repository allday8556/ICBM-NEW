* text=auto eol=lf

*.png binary
*.jpg binary
*.ttf binary

# Approved UI prototypes are fingerprinted byte-for-byte (documents/contracts/ui/UI_SOURCE_OF_TRUTH.md).
# Never convert their line endings on checkout.
design/prototypes/*.html -text

# Agent Host scripts are pinned byte-for-byte by sha256 (documents/rules/agent-host/AGENT_HOST_AUDIT_PROTOCOL.md; automation/agent-host/README.md).
# Never convert their line endings or strip their BOM.
automation/agent-host/** -text whitespace=cr-at-eol
